# ==========================================
# Open Sentry 本地主程序 + Docker 基础设施 环境变量
# ==========================================
# 1. 生成强密码:
#    openssl rand -base64 32
# 2. 替换所有 example.com 为你的真实域名
# ==========================================

# --- Docker: PostgreSQL ---
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Rust 后端 ---
APP__ENVIRONMENT=production
APP__BIND_ADDR=0.0.0.0:8080
APP__DATABASE_URL=postgres://sentry:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/open_sentry
APP__INGEST_API_KEY=REPLACE_WITH_STRONG_SECRET
APP__PUBLIC_BASE_URL=https://sentry.example.com
APP__BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP__BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS
APP__SECURE_COOKIES=true
APP__METRICS_API_KEY=REPLACE_WITH_STRONG_SECRET
APP__INGEST_RATE_LIMIT_PER_MINUTE=600
APP__RETENTION_DAYS=30
APP__RETENTION_INTERVAL_SECONDS=3600
APP__WORKER_POLL_INTERVAL_MS=1000

# --- Next.js 前端（服务器端 proxy route 使用） ---
BACKEND_API_URL=http://127.0.0.1:8080
