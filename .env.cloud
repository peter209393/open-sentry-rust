# ==========================================
# Open Sentry 云服务器生产环境配置
# ==========================================
# 1. 生成强密码（建议 32 位以上随机字符串）:
#    openssl rand -base64 32
# 2. 替换所有 example.com 为你的真实域名
# ==========================================

# PostgreSQL 密码
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# 后端配置
INGEST_API_KEY=REPLACE_WITH_STRONG_SECRET
PUBLIC_BASE_URL=https://sentry.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_12_CHARS
METRICS_API_KEY=REPLACE_WITH_STRONG_SECRET
INGEST_RATE_LIMIT_PER_MINUTE=600
RETENTION_DAYS=30

# 前端配置（用于 Sentry SDK 自监控，可选）
PUBLIC_SENTRY_DSN=https://public-key@sentry.example.com/1
NEXT_PUBLIC_PROJECT_ID=00000000-0000-0000-0000-000000000001
