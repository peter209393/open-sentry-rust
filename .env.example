APP__BIND_ADDR=0.0.0.0:8080
APP__ENVIRONMENT=development
APP__DATABASE_URL=postgres://sentry:sentry@127.0.0.1:55432/open_sentry?sslmode=disable
APP__INGEST_API_KEY=dev-secret
APP__PUBLIC_BASE_URL=http://localhost:8080
APP__BOOTSTRAP_ADMIN_EMAIL=admin@example.com
